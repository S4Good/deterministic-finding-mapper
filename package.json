{
  "name": "deterministic-finding-mapper",
  "version": "1.0.0",
  "private": true,
  "description": "Educational prototype for deterministic mapping of scanner findings to fictional compliance controls.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "demo": "npm run build && node dist/demo.js",
    "test": "npm run build:test && node --test dist-test/test/**/*.test.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
